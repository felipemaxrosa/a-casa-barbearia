# ──────────────────────────────────────────────
# Sanity — https://sanity.io/manage
# ──────────────────────────────────────────────
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
NEXT_PUBLIC_SANITY_API_VERSION=2026-10-20

# Token de leitura (Sanity → API → Tokens → "Read Only")
# Necessário para draft mode / Live Content API
SANITY_API_READ_TOKEN=

# ──────────────────────────────────────────────
# Site
# ──────────────────────────────────────────────
# URL pública (ex: https://acasa-barbearia.vercel.app)
NEXT_PUBLIC_SITE_URL=

# WhatsApp/telefone da barbearia (formato internacional: 351912345678)
NEXT_PUBLIC_PHONE=351912345678
NEXT_PUBLIC_WHATSAPP=351912345678
